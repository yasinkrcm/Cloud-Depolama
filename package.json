{
  "name": "cloud-storage-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "client",
    "packages/types"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:client\"",
    "dev:backend": "bun --cwd backend run dev",
    "dev:client": "bun --cwd client run dev",
    "typecheck": "bun run typecheck:backend && bun run typecheck:client",
    "typecheck:backend": "bun --cwd backend run typecheck",
    "typecheck:client": "bun --cwd client run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run test:backend && bun run test:client",
    "test:backend": "bun --cwd backend test",
    "test:client": "bun --cwd client test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.2.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript-eslint": "^8.57.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bun run tsc --noEmit"
    ]
  }
}
